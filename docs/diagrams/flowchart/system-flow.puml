@startuml title
title Алгоритм работы имитационной модели — вариант 6

start

partition "SimulationEngine" {
    :Инициализировать модель;
    :Создать первые события\nгенерации заявок;
}

while (Моделирование продолжается?) is (Да)

    partition "SimulationEngine" {
        :Выбрать ближайшее событие;
        :Установить currentTime = event.time;
    }

    if (Тип события = REQUEST_GENERATED?) then (Да)

        partition "Source" {
            :Создать новую заявку;
            note right
            ИБ — бесконечный источник
            ИЗ2 — равномерный закон
            end note

            :Запланировать момент\nследующей генерации;
        }

        partition "Statistics" {
            :Увеличить число\nсгенерированных заявок;
        }

        partition "PlacementDispatcher" {
            :Запросить состояние Buffer;
        }

        partition "Buffer" {
            if (Buffer заполнен?) then (Нет)
                :Добавить заявку\nв конец очереди;

                note right
                Д1ОЗ2 — постановка в порядке поступления
                end note

            else (Да)
                :Получить заявки\nминимального приоритета;

                note right
                Д1ОО2 — отказ по приоритету источника
                end note

                if (Таких заявок несколько?) then (Да)

                    :Выбрать наиболее старую;

                else (Нет)

                    :Выбрать единственного кандидата;

                endif

                :Удалить выбранную заявку;

                partition "Statistics" {
                    :Зафиксировать отказ;
                }

                partition "Buffer" {
                    :Добавить новую заявку\nв конец очереди;
                }

            endif
        }

        partition "DevicePool" {
            :Проверить наличие\nсвободного worker;
        }

        if (Свободный worker есть?) then (Да)

            partition "SelectionDispatcher" {

                if (Активный Packet существует?) then (Нет)

                    partition "Buffer" {
                        :Найти наиболее\nприоритетный источник;
                        :Получить заявки этого источника;
                    }

                    partition "SelectionDispatcher" {
                        :Создать фиксированный Packet;

                        note right
                        Д2Б5 - после создания
                        пакет не расширяется.
                        end note
                    }

                else (Да)
                    :Продолжить текущий Packet;

                endif
            }

            partition "DevicePool" {
                :Найти свободный worker\nпо кольцу;

                note right
                Д2П2 - выбор worker по кольцу
                end note

                :Передвинуть указатель;
            }

            partition "SelectionDispatcher" {
                :Получить следующую заявку\nиз активного Packet;
            }


            partition "Buffer" {
                :Удалить выбранную заявку\nиз очереди;
            }

            partition "Worker" {
                :Начать обслуживание заявки;

                note right
                ПЗ1 - экспоненциальное
                время обслуживания
                end note

                :Создать событие\nSERVICE_COMPLETED;
            }

        else (Нет)

            partition "SimulationEngine" {
                :Продолжить ожидание\nследующего события;
            }

        endif

    else (Нет)

        if (Тип события = SERVICE_COMPLETED?) then (Да)

            partition "Worker" {
                :Закончить обслуживание;
                :Перейти в состояние FREE;
            }

            partition "Statistics" {
                :Записать время обслуживания;
                :Записать время ожидания;
                :Записать время пребывания;
                :Увеличить число обработанных;
            }

            partition "SelectionDispatcher" {

                if (Активный Packet пуст?) then (Да)

                    :Закрыть текущий Packet;

                    partition "Buffer" {

                        if (Buffer пуст?) then (Да)

                            :Нечего передавать\nна обслуживание;

                        else (Нет)

                            :Найти наиболее\nприоритетный источник;
                            :Получить заявки источника;

                            partition "SelectionDispatcher" {
                                :Создать новый Packet\nД2Б5;
                            }

                        endif
                    }

                else (Нет)

                    :Продолжить текущий Packet;

                endif
            }

        else (Нет)

            partition "SimulationEngine" {
                :Обработать событие\nзавершения моделирования;
            }

        endif

    endif

endwhile (Нет)

partition "Statistics" {
    :Рассчитать итоговые показатели;
    :Сформировать сводную таблицу ОР1;
}

stop
@enduml